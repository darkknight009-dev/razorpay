# Keep MOCK_MODE=true for the offline demo. Live mode requires the two Freshdesk values below.
MOCK_MODE=true
FRESHDESK_DOMAIN=your-subdomain.freshdesk.com
FRESHDESK_API_KEY=replace-with-a-test-only-api-key

# Operational bounds; safe defaults are used when omitted.
FRESHDESK_TIMEOUT_SECONDS=10
FRESHDESK_MAX_RETRIES=2
FRESHDESK_RETRY_BASE_SECONDS=0.25
FRESHDESK_REQUEST_SPACING_SECONDS=0
FRESHDESK_MAX_LIST_PAGES=10
FRESHDESK_MAX_LIST_RESULTS=1000
